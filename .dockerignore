# Allow-list build context for the kernel image (BuildKit, context = repo root).
# Exclude everything first, then re-include only what `pnpm install --frozen-lockfile` and
# `pnpm --filter @oscorpex/kernel... build` need. New top-level files never leak by default.
*

# Root manifests
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!tsconfig.json

# Every workspace manifest (required for a frozen-lockfile install; console ships only this file)
!apps/*/package.json
!packages/*/package.json
!adapters/*/package.json

# Kernel
!apps/kernel/src
!apps/kernel/tsconfig*.json
!apps/kernel/tsdown.config.ts
!apps/kernel/scripts/init.sql
!apps/kernel/scripts/admin-grant.ts

# Workspace packages and adapters
!packages/*/src
!packages/*/tsconfig*.json
!packages/*/tsdown.config.ts
!adapters/*/src
!adapters/*/tsconfig*.json
!adapters/*/tsdown.config.ts

# Claude CLI image assets (created in phase D3)
!docker/claude-cli/package.json
!docker/claude-cli/managed-settings.json
!docker/claude-cli/pnpm-lock.yaml
!docker/claude-cli/pnpm-workspace.yaml

# Re-exclude regardless of the above (last match wins)
# >>> common-deny (keep identical in every .dockerignore)
**/node_modules
**/dist
**/.env*
**/.oscorpex
**/.voltagent
**/.serena
**/.claude*
**/.credentials.json
**/.mcp.json
**/.git
**/.npmrc
**/.yarnrc*
**/.netrc
**/.pgpass
**/.git-credentials
**/.aws
**/.ssh
**/.gnupg
**/.kube
**/.docker
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.ppk
**/id_rsa*
**/id_dsa*
**/id_ecdsa*
**/id_ed25519*
**/credentials.json
**/service-account*.json
**/*.tfstate*
**/*.sqlite*
**/*.db
**/*.dump
**/*.log
**/.history
**/.idea
**/.vscode
**/.cursor
**/.playwright-mcp
**/*.swp
**/*~
**/.DS_Store
**/.tmp
**/coverage
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.test.js
**/*.spec.ts
**/*.spec.tsx
**/*.js.map
**/*.tsbuildinfo
**/src/**/*.js
# <<< common-deny
