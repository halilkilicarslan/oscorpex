# AI Provider Configuration
# Copy this file to .env and add your API keys

# OpenAI API Key
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# VoltOps Observability
# For production monitoring and observability
# Get your keys at https://console.voltagent.dev/tracing-setup
# VOLTAGENT_PUBLIC_KEY=
# VOLTAGENT_SECRET_KEY=

# Database
DATABASE_URL=postgresql://oscorpex:CHANGE_ME@localhost:5432/oscorpex
# Schema migrations (local: a superuser such as postgresql://<macOS-user>@localhost:5432/oscorpex)
OSCORPEX_MIGRATION_DATABASE_URL=
# Only for docker compose; generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
# Node Environment
NODE_ENV=development
