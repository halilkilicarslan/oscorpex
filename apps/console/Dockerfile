# Production console image. Build context = repo root, filtered by apps/console/Dockerfile.dockerignore.
# base (pinned node + corepack) -> manifests / deps -> build (vite) -> runtime (unprivileged nginx serving dist).
#   docker buildx build -f apps/console/Dockerfile -t oscorpex-console .

FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS base
RUN corepack enable

# Only the manifests a frozen install needs, so source edits never invalidate the dependency layer.
FROM base AS manifests
WORKDIR /ctx
COPY . .
RUN mkdir /manifests \
	&& find . -type f \( -name package.json -o -name pnpm-lock.yaml -o -name pnpm-workspace.yaml \) \
		| tar -cf - -T - | tar -xf - -C /manifests

FROM base AS deps
ENV PNPM_HOME=/pnpm \
	npm_config_store_dir=/pnpm/store \
	CI=true
WORKDIR /repo
COPY --from=manifests /manifests ./
RUN --mount=type=cache,id=oscorpex-pnpm-store,target=/pnpm/store \
	pnpm install --frozen-lockfile --filter "console..."

FROM deps AS build
COPY . .
RUN pnpm --filter console build

# nginx 1.30.5 (stable), published 2026-10-12
FROM nginxinc/nginx-unprivileged:1.30.5-alpine@sha256:56b8272e43a0525f67aed68d1e0794a712d10e3e45a563e118e9a77c817e6f86 AS runtime
# root-owned and not writable by uid 101; the base image's nginx.conf already keeps pid and temp paths in /tmp
COPY --from=build /repo/apps/console/dist /usr/share/nginx/html
COPY --chmod=0644 apps/console/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --chmod=0644 apps/console/nginx/security-headers.conf apps/console/nginx/security-headers-api.conf apps/console/nginx/proxy-params.conf /etc/nginx/
# The base image leaves /etc/nginx group-writable for uid 101 (entrypoint rewrites); lock it down. dist is already
# root-owned from COPY, so no recursive chown there (it would duplicate the files in a layer).
USER 0
# ca-cert-*.pem are per-certificate copies generated by the apk trigger (not package-owned); ca-certificates.crt keeps the bundle
RUN chown -R root:root /etc/nginx && chmod -R go-w /etc/nginx \
	&& rm -f /etc/ssl/certs/ca-cert-*.pem \
	&& find -L /etc/ssl/certs -type l -delete
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
	CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/index.html"]
USER 101
