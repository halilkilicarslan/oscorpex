{
	"name": "oscorpex-monorepo",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
	"description": "Oscorpex — AI-powered software development platform (monorepo root)",
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @oscorpex/kernel dev",
		"dev:console": "pnpm --filter @oscorpex/console dev",
		"build": "pnpm -r build",
		"build:kernel": "pnpm --filter @oscorpex/kernel build",
		"build:console": "pnpm --filter @oscorpex/console build",
		"build:packages": "pnpm -r --filter './packages/*' build",
		"lint": "pnpm --filter @oscorpex/kernel lint",
		"lint:fix": "pnpm --filter @oscorpex/kernel lint:fix",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm --filter @oscorpex/kernel test",
		"test:watch": "pnpm --filter @oscorpex/kernel test:watch",
		"test:coverage": "pnpm --filter @oscorpex/kernel test:coverage",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"seed:beta05d": "npx tsx scripts/seed-beta05d-e2e.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"typescript": "^5.7.3",
		"vitest": "^4.1.2"
	},
	"engines": {
		"node": ">=20.19.0"
	}
}
