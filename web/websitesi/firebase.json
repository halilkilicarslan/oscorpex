{
  "hosting": {
    "site": "oscorpex-37fa4",
    "public": ".",
    "cleanUrls": true,
    "ignore": ["firebase.json", ".firebaserc", "DEPLOY.md", "functions/**", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] },
      { "source": "**/*.@(svg|png|jpg|webp|ico)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }] }
    ]
  }
}
